# Copia este archivo a .env y completa los valores. NO subas .env al repositorio.
# Autenticación: azure-identity (DefaultAzureCredential) -> `az login`; no se guardan claves aquí.
PROJECT_ENDPOINT=
MODEL_ENDPOINT=
MODEL_DEPLOYMENT_NAME=
AGENT_NAME=

# Opcionales
# API_BASE_URL=http://127.0.0.1:8000   # si se define, las tools consultan la API en vez del CSV
# FECHA_REFERENCIA=2026-11-12          # fecha "hoy" del negocio (datos de prueba reproducibles)
# LOG_ARCHIVO=logs/agente.jsonl        # además de stderr
